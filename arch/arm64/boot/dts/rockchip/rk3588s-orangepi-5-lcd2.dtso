/*
 * Orange Pi 10.1" MIPI LCD (Innolux AFJ101-BA2131, ILI9881C, 800x1280,
 * Goodix GT9271 touch) on the LCD2 connector of the Orange Pi 5.
 *
 * LCD2 is wired to DSI1 and MIPI DCPHY1. The connector signals are taken
 * from the Orange Pi BSP device trees (rk3588s-orangepi-5-lcd.dtsi and
 * rk3588s-orangepi-5.dtsi in orangepi-xunlong/linux-orangepi):
 *   LCD power enable: GPIO1_A1, panel reset: GPIO1_B3 (active low),
 *   backlight PWM: PWM6_M0 (GPIO0_C7),
 *   touch: I2C2_M0 (shared with the vdd_npu_s0 regulator), INT GPIO1_A7,
 *   RESET GPIO1_A4.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>

&{/} {
	backlight_lcd2: backlight-lcd2 {
		compatible = "pwm-backlight";
		pwms = <&pwm6 0 25000 0>;
	};

	vcc_lcd2: regulator-vcc-lcd2 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio1 RK_PA1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd2_pwr_en>;
		regulator-name = "vcc_lcd2";
	};
};

&dsi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "innolux,afj101-ba2131", "ilitek,ili9881c";
		reg = <0>;
		backlight = <&backlight_lcd2>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd2_rst>;
		power-supply = <&vcc_lcd2>;
		reset-gpios = <&gpio1 RK_PB3 GPIO_ACTIVE_LOW>;

		port {
			lcd2_panel_in: endpoint {
				remote-endpoint = <&dsi1_out_lcd2>;
			};
		};
	};
};

&dsi1_in {
	dsi1_in_vp2: endpoint {
		remote-endpoint = <&vp2_out_dsi1>;
	};
};

&dsi1_out {
	dsi1_out_lcd2: endpoint {
		remote-endpoint = <&lcd2_panel_in>;
	};
};

&i2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	touchscreen@14 {
		compatible = "goodix,gt9271";
		reg = <0x14>;
		interrupt-parent = <&gpio1>;
		interrupts = <RK_PA7 IRQ_TYPE_LEVEL_LOW>;
		irq-gpios = <&gpio1 RK_PA7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd2_touch_int &lcd2_touch_rst>;
		reset-gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_HIGH>;
		touchscreen-inverted-x;
		touchscreen-size-x = <1280>;
		touchscreen-size-y = <800>;
		touchscreen-swapped-x-y;
	};
};

&mipidcphy1 {
	status = "okay";
};

&pinctrl {
	lcd2 {
		lcd2_pwr_en: lcd2-pwr-en {
			rockchip,pins = <1 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lcd2_rst: lcd2-rst {
			rockchip,pins = <1 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lcd2_touch_int: lcd2-touch-int {
			rockchip,pins = <1 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lcd2_touch_rst: lcd2-touch-rst {
			rockchip,pins = <1 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pwm6 {
	status = "okay";
};

&vp2 {
	#address-cells = <1>;
	#size-cells = <0>;

	vp2_out_dsi1: endpoint@ROCKCHIP_VOP2_EP_MIPI1 {
		reg = <ROCKCHIP_VOP2_EP_MIPI1>;
		remote-endpoint = <&dsi1_in_vp2>;
	};
};
